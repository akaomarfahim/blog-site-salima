<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · SALIMA'S BLOG</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="top-rule"></div>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">SALIMA'S BLOG</a>
      <nav class="nav">
        <a href="/">Home</a>
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin">Dashboard</a>
          <% } %>
          <span class="nav-user">Hi, <%= currentUser.username %></span>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="link-button">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
         <a href="/register" class="btn btn-small" style="background-color: #0F172A; color: #ffffff; text-decoration: none;">Sign up</a>
        <% } %>
      </nav>
    </div>
    <div class="header-rule"></div>
  </header>
  <main class="container">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>
